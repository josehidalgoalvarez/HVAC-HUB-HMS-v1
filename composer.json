{
  "name": "hvachome/api",
  "description": "HVACHome v2 Slim 4 JSON API",
  "type": "project",
  "require": {
    "php": ">=8.1",
    "slim/slim": "4.*",
    "slim/psr7": "^1.7"
  },
  "autoload": {
    "psr-4": {
      "App\\": "src/"
    }
  },
  "config": {
    "optimize-autoloader": true,
    "sort-packages": true
  }
}
